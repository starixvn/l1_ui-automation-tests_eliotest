{
  "name": "automation-tests",
  "version": "1.0.0",
  "description": "End-to-end and smoke tests for automation",
  "main": "index.js",
  "scripts": {
    "test:smoke": "playwright test --project=Smoke_Club --workers=2",
    "test:smoke:sbp": "playwright test --project=Smoke_Saba_Play --workers=2",
    "test:smoke:is": "playwright test --project=Smoke_Instant_Play --workers=2",
    "test:smoke:mobi": "playwright test --project=Smoke_Mobi --workers=2",
    "test:smoke:keno": "playwright test --project=Smoke_Keno --workers=2",
    "test:smoke:xd": "playwright test --project=Smoke_XD --workers=1",
    "test:e2e": "playwright test --config=e2e.config.ts --project=E2E_CI",
    "test:guide": "playwright test --config=e2e.config.ts --project=Guide --workers=3",
    "test:admin": "playwright test --project=admin",
    "update-snapshots": "playwright test --update-snapshots  --project=Smoke_Club",
    "clonegame": "node clonegame.js",
    "sendresult": "node pushResults.js",
    "allure": "node allureReport.js"
  },
  "repository": {
    "type": "git",
    "url": "git@git3.nexdev.net:l1/ui-automation-tests/automation-tests.git"
  },
  "author": "pentagon@luminet.com",
  "license": "MIT",
  "dependencies": {
    "allure-playwright": "^3.0.0-beta.9",
    "fs-extra": "^11.1.1",
    "google-spreadsheet": "^4.1.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.2.5",
    "prom-client": "^15.1.3",
    "sc-automation-core": "1.55.1-beta.1"
  },
  "devDependencies": {
    "@playwright/test": "1.44.0",
    "csv-stringify": "^6.5.0",
    "notepack.io": "^3.0.1",
    "tslib": "2.4.1"
  }
}
